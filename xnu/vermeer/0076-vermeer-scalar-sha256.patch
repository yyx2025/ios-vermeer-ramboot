+/* SHA256 is used during pre-mount RAM-root verification and code signing.
+ * The pinned BearSSL provider is compiled with general registers only,
+ * matching this port's other portable libkern hash implementations. */
+#include "sweet_bearssl/inc/bearssl_hash.h"
+_Static_assert(sizeof(br_sha256_context) <= sizeof(SHA256_CTX),
+    "BearSSL SHA256 context must fit in SHA256_CTX");
+#define BR_SHA256_CTX(ctx) ((br_sha256_context *)(void *)(ctx))
+
+void
+SHA256_Init(SHA256_CTX *ctx)
+{
+    br_sha256_init(BR_SHA256_CTX(ctx));
+}
+
+void
+SHA256_Update(SHA256_CTX *ctx, const void *data, size_t len)
+{
+    br_sha256_update(BR_SHA256_CTX(ctx), data, len);
+}
+
+void
+SHA256_Final(void *digest, SHA256_CTX *ctx)
+{
+    br_sha256_out(BR_SHA256_CTX(ctx), digest);
